{
  "name": "@chilfish/tweet",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "bun@1.4.4",
  "description": "X (Twitter) data extraction + tweet enrichment SDK — platform-neutral core, Node adapters and React components.",
  "author": "Chilfish",
  "license": "MIT",
  "homepage": "https://github.com/Chilfish/tweet-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chilfish/tweet-sdk.git"
  },
  "bugs": "https://github.com/Chilfish/tweet-sdk/issues",
  "keywords": [
    "twitter",
    "x",
    "tweet",
    "scraper",
    "sdk"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE.md",
    "NOTICE.md",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "bun run typecheck && bun run lint:check && bun run test:coverage && bun run build && bun run verify:package",
    "check:docs": "node scripts/check-docs.mjs",
    "example": "bun examples/basic.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:tag": "node scripts/verify-release-tag.mjs",
    "prepublishOnly": "bun run build",
    "release": "bumpp --commit \"chore(release): v{version}\" --tag --push",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "linkedom": "^0.18.15",
    "undici": "^8.12.4",
    "x-client-transaction-id": "^0.3.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "lefthook": "^2.2.2",
    "tsdown": "^0.23.7",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  }
}
